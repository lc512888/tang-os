# Tang OS — Environment Variables
# Copy this file to .env and fill in your keys.
#
# Note: Tang OS currently reads from environment variables directly.
# A .env file loader may be added in a future release.

# --- LLM Provider: DeepSeek (recommended, fully supported) ---
DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# --- LLM Provider: OpenAI (interface skeleton) ---
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- LLM Provider: Claude (interface skeleton) ---
# ANTHROPIC_API_KEY="sk-ant-..."
